# Copie para .env.local (desenvolvimento) ou cadastre no Vercel → Settings → Environment Variables.
# Supabase → Settings → API. Use a chave "anon / public" — NUNCA a service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Notificações push (só no Vercel, NUNCA com prefixo VITE_). Ver README.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:voce@exemplo.com
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=

# Rotas da Logística (só no Vercel, NUNCA com prefixo VITE_). Use uma das duas; sem nenhuma, trechos à mão.
# GOOGLE_MAPS_API_KEY=   # Routes API + Geocoding API (trânsito previsto e pedágios)
# ORS_API_KEY=           # OpenRouteService (gratuito, sem trânsito e sem pedágios)
