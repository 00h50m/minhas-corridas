{
  "rewrites": [
    { "source": "/agenda/:token/paceon.ics", "destination": "/api/agenda?t=:token" },
    { "source": "/agenda/:token/minhas-corridas.ics", "destination": "/api/agenda?t=:token" },
    { "source": "/((?!api/|agenda/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/push-cron", "schedule": "0 11 * * *" },
    { "path": "/api/push-cron?slot=noite", "schedule": "0 23 * * *" }
  ]
}
